# Скопіюйте в .env.local (не комітьте!) — Supabase Dashboard → Project Settings → API
# Активний проєкт DImarket (замість старого qwvbbvipqmmrpmyysczh):

VITE_SUPABASE_URL=https://wjlfvajloxkevggwjgtk.supabase.co
VITE_SUPABASE_ANON_KEY=PASTE_ANON_KEY_HERE

# Локальна розробка (після supabase start):
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=your_local_anon_key

# Скрипти (geo:sync, db:apply-*). Не комітьте реальні значення.
# SUPABASE_SERVICE_ROLE_KEY=...   (Dashboard → Settings → API → service_role)
# SUPABASE_ACCESS_TOKEN=sbp_...   (Dashboard → Account → Access Tokens)
# GEONAMES_USERNAME=...           (geonames.org → manageaccount → enable free web services)

# Секрети Stripe — лише на сервері (Supabase Edge Functions secrets), НЕ додавайте в Vite:

# supabase secrets set STRIPE_SECRET_KEY=sk_test_...
# supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...   # опційно для webhook
