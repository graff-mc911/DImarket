# Скопіюйте в .env.local (не комітьте!) — Supabase Dashboard → Project Settings → API
# Активний проєкт DImarket (замість старого qwvbbvipqmmrpmyysczh):

VITE_SUPABASE_URL=https://wjlfvajloxkevggwjgtk.supabase.co
VITE_SUPABASE_ANON_KEY=PASTE_ANON_KEY_HERE

# Локальна розробка (після supabase start):
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=your_local_anon_key

# Скрипти (geo:sync, db:apply-*). Не комітьте реальні значення.
# SUPABASE_SERVICE_ROLE_KEY=...   (Dashboard → Settings → API → service_role)
# SUPABASE_ACCESS_TOKEN=sbp_...   (Dashboard → Account → Access Tokens)
# GEONAMES_USERNAME=...           (geonames.org → manageaccount → enable free web services)

# Секрети Stripe — лише на сервері (Supabase Edge Functions secrets), НЕ додавайте в Vite:

# supabase secrets set STRIPE_SECRET_KEY=sk_test_...
# supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...   # опційно для webhook

# AI Edge Functions (лише .env.local + npm run secrets:ai — НЕ VITE_*):
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini
# GOOGLE_VISION_API_KEY=...
# TELEGRAM_BOT_TOKEN=...
# WHATSAPP_ACCESS_TOKEN=...

# Marketing Agent (Supabase Edge secrets — NOT VITE_*):
# ANTHROPIC_API_KEY=...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# TELEGRAM_CHANNEL_ID=...          # channel for auto-posts
# FACEBOOK_PAGE_ID=...
# FACEBOOK_ACCESS_TOKEN=...
# DEEPL_API_KEY=...
# Deploy: npx supabase functions deploy marketing-agent --project-ref wjlfvajloxkevggwjgtk

# Admin AI Assistant (Supabase Edge secrets — NOT VITE_*):
# ANTHROPIC_API_KEY=...            # Claude chat (shared with marketing-agent)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# RESEND_API_KEY=re_...            # Email notifications
# RESEND_FROM_EMAIL=DImarket <noreply@dimarket.app>
# TAVILY_API_KEY=tvly-...          # Web search (optional)
# TELEGRAM_ADMIN_CHAT_ID=...       # Admin alert channel
# ADMIN_EMAIL=ivan.sovban@gmail.com
# Deploy: npm run deploy:admin-ai
# Migration: npm run db:apply-admin-ai
