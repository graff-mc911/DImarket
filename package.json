{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/seo-build.mjs",
    "build:app": "vite build",
    "build:seo": "vite build && node scripts/seo-build.mjs",
    "seo:build": "node scripts/seo-build.mjs",
    "seo:verify": "node scripts/seo-verify.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "npm run typecheck && node scripts/verify-registration-logic.mjs && npm run test:commercial-agents && npm run test:ai-intents && npm run test:smoke",
    "test:smoke": "node scripts/production-smoke.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen http://127.0.0.1:4173",
    "test:e2e:install": "playwright install chromium",
    "test:registration": "node scripts/verify-registration-logic.mjs && node scripts/test-registration-roles.mjs",
    "db:apply-paid-ads": "powershell -ExecutionPolicy Bypass -File scripts/apply-paid-ads-sql.ps1",
    "db:apply-auth-profile": "node scripts/apply-auth-profile-migration.mjs",
    "db:apply-self-serve-ads": "node scripts/apply-prod-ad-self-serve.mjs",
    "db:apply-self-serve-ads:ps1": "powershell -ExecutionPolicy Bypass -File scripts/apply-prod-ad-self-serve.ps1",
    "db:verify-prod-ads": "node scripts/verify-prod-ad-schema.mjs",
    "db:delete-demo-ads": "node scripts/apply-delete-demo-ads.mjs",
    "db:delete-cursor-cloud-test": "node scripts/apply-delete-cursor-cloud-test-listing.mjs",
    "db:apply-cost-estimates": "node scripts/apply-cost-estimates-migration.mjs",
    "db:apply-project-escrows": "node scripts/apply-project-escrows-migration.mjs",
    "db:apply-stripe-connect": "node scripts/apply-stripe-connect-migration.mjs",
    "db:apply-commercial-agents": "node scripts/apply-commercial-agents-migration.mjs",
    "db:seed-commercial-agents": "node scripts/seed-commercial-agents-demo.mjs",
    "db:generate-ca-manufacturers-sql": "node scripts/generate-ca-manufacturers-sql.mjs",
    "test:commercial-agents": "node scripts/verify-commercial-agents-matching.mjs",
    "test:commercial-agents:prod": "node scripts/verify-commercial-agents-prod.mjs",
    "test:official-sources": "node scripts/verify-official-source-monitor.mjs",
    "db:apply-official-sources": "node scripts/apply-official-source-monitor.mjs",
    "deploy:official-sources": "npx supabase functions deploy official-sources-monitor --project-ref wjlfvajloxkevggwjgtk",
    "geo:sync": "node scripts/sync-geo-catalog-dump.mjs",
    "geo:sync:one": "node scripts/sync-geo-catalog-dump.mjs --country=Germany",
    "geo:sync:api": "node scripts/sync-geo-catalog-geonames.mjs",
    "db:deploy-checkout-functions": "npx supabase functions deploy create-checkout-session verify-checkout-session release-project-escrow stripe-webhook stripe-connect --project-ref wjlfvajloxkevggwjgtk",
    "icons:generate": "node scripts/generate-favicons.mjs",
    "deploy:prod": "npx vercel deploy --prod --yes",
    "db:apply-ai-platform": "node scripts/apply-ai-platform-migration.mjs",
    "db:apply-phase1": "node scripts/apply-phase1-migration.mjs",
    "deploy:phase1-functions": "node scripts/deploy-phase1-functions.mjs",
    "deploy:phase1": "node scripts/apply-phase1-migration.mjs && node scripts/deploy-phase1-functions.mjs",
    "secrets:ai": "node scripts/set-ai-edge-secrets.mjs",
    "deploy:marketing-agent": "npx supabase functions deploy marketing-agent --project-ref wjlfvajloxkevggwjgtk",
    "deploy:scb-provision": "npx supabase functions deploy provision-scb-account --project-ref wjlfvajloxkevggwjgtk",
    "db:apply-marketing-agent": "node scripts/apply-marketing-agent-migration.mjs",
    "marketing:setup": "node scripts/setup-marketing-full.mjs",
    "marketing:cron": "node scripts/marketing-cron-invoke.mjs",
    "marketing:telegram": "node scripts/setup-telegram-marketing.mjs",
    "db:apply-telegram-bot": "node scripts/apply-telegram-bot-migration.mjs",
    "db:apply-telegram-authors": "node scripts/apply-telegram-authors-migration.mjs",
    "db:backfill-telegram-authors": "node scripts/backfill-telegram-listing-authors.mjs",
    "deploy:telegram-bot": "npx supabase functions deploy telegram-bot --project-ref wjlfvajloxkevggwjgtk",
    "telegram:setup": "node scripts/setup-telegram-listings-bot.mjs",
    "db:apply-admin-ai": "node scripts/apply-admin-ai-migration.mjs",
    "db:apply-admin-rating": "node scripts/apply-admin-local-rating-rpc.mjs",
    "deploy:admin-ai": "npx supabase functions deploy admin-ai-assistant send-notification --project-ref wjlfvajloxkevggwjgtk",
    "test:registration:live": "node scripts/test-registration-roles.mjs",
    "test:ai-intents": "node scripts/verify-ai-intent-routing.mjs"
  },
  "dependencies": {
    "@sentry/react": "^8.55.2",
    "@supabase/supabase-js": "^2.57.4",
    "framer-motion": "^12.42.2",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.6",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.60.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.35",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
